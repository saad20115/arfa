# ARFA - native deployment settings (no Docker). Edit before running 10_install.sh if needed.
# إعدادات تثبيت موقع عرفة كخدمة مستقلة. عدّلها قبل التثبيت عند الحاجة.

ARFA_REPO=/opt/arfa                  # clone of github.com/saad20115/arfa (contains custom_addons/)
ARFA_RUNTIME=/opt/arfa_runtime       # own Odoo 19 source + Python venv (not shared with other apps)
ODOO_BRANCH=19.0
ODOO_GIT=https://github.com/odoo/odoo.git

ARFA_USER=arfa                       # Linux user running the service (also the PostgreSQL role, peer auth)
DB_NAME=arfa_prod                    # new database (the server already has: jazira, arafa)
SERVICE=arfa                         # systemd service name -> arfa.service
CONF_DIR=/etc/arfa
DATA_DIR=/var/lib/arfa               # filestore
LOG_DIR=/var/log/arfa
BACKUP_DIR=/opt/arfa_backups

HTTP_PORT=18069                      # Odoo, bound to 127.0.0.1 only
CHAT_PORT=18072                      # Odoo websocket (gevent), 127.0.0.1 only
TRIAL_PORT=8090                      # public trial link through nginx: http://SERVER_IP:8090
WORKERS=3
TRIAL_USER=arfa                      # basic-auth user for the trial link (password generated)

# set only if PostgreSQL is not on the default local socket
PGHOST_OVERRIDE=
PGPORT_OVERRIDE=
