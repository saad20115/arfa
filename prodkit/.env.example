# =============================================================================
# ARFA production settings. install.sh copies this to .env (chmod 600) and fills
# the EMPTY secrets with strong random values. Never commit .env to git.
# إعدادات النشر - ينسخها install.sh إلى .env ويولّد كلمات المرور الفارغة تلقائياً.
# Values must not contain spaces or quotes.
# =============================================================================

# ---- paths on the VPS / المسارات ----
ARFA_HOME=/opt/arfa
ARFA_ADDONS_DIR=/opt/arfa/custom_addons
ARFA_BACKUP_DIR=/opt/arfa/backups

# ---- database (own container, never published) / قاعدة البيانات ----
# dbfilter becomes ^arfa_prod$ ; keep a name no other app uses
ARFA_DB_NAME=arfa_prod
ARFA_DB_USER=odoo
# set once by install.sh - PostgreSQL keeps the first value, do not change it afterwards
ARFA_DB_PASSWORD=
# Odoo master password (database manager is also blocked in nginx + list_db=False)
ARFA_ADMIN_PASSWD=

# ---- images (pin a dated tag for reproducible deploys, e.g. odoo:19.0-20261001) ----
ARFA_ODOO_IMAGE=odoo:19.0
ARFA_PG_IMAGE=postgres:16
ARFA_NGINX_IMAGE=nginx:1.27-alpine

# ---- ports / المنافذ ----
# Odoo is published on 127.0.0.1 ONLY (pick ports no other app uses; preflight checks)
ARFA_HTTP_PORT=18069
ARFA_CHAT_PORT=18072
# Phase 1 public trial port: http://SERVER_IP:8090
ARFA_TRIAL_PORT=8090
# empty = auto-detected by install.sh
ARFA_PUBLIC_IP=

# ---- trial protection / حماية رابط التجربة ----
# 1 = nginx asks for a username/password (recommended for the client preview)
ARFA_TRIAL_AUTH=1
ARFA_TRIAL_AUTH_USER=arfa
ARFA_TRIAL_AUTH_PASSWORD=

# ---- nginx ----
# auto = use host nginx if it runs, else the nginx container (docker-compose.nginx.yml)
ARFA_NGINX_MODE=auto
# only if other vhosts listen on a specific IP (listen 1.2.3.4:80) - preflight tells you
ARFA_NGINX_LISTEN_IP=
# auto|0|1  (auto: IPv6 on :80/:443 only if other vhosts already use [::]:80)
ARFA_IPV6=auto
# auto|0|1  (auto: "http2 on;" only on nginx >= 1.25.1, never changes other vhosts)
ARFA_HTTP2=auto

# ---- phase 2: domain / النطاق ----
ARFA_DOMAIN=arfa-sa.com
# apex = https://arfa-sa.com (www redirects to it)   |   www = the reverse
ARFA_CANONICAL=apex
# email for Let's Encrypt expiry notices
ARFA_LE_EMAIL=
# 0 until HTTPS is confirmed working; then enable_domain.sh --hsts
ARFA_HSTS=0
# 1 = keep http://IP:8090 (still noindex) after the domain goes live (host nginx only)
ARFA_KEEP_TRIAL_AFTER_DOMAIN=0
ARFA_ACME_WEBROOT=/var/www/arfa_prod_acme

# ---- resources (shared VPS: be modest) / الموارد ----
# auto = min(2*CPU+1, ARFA_WORKERS_CAP)
ARFA_WORKERS=auto
ARFA_WORKERS_CAP=4
ARFA_ODOO_MEM=4g
ARFA_DB_MEM=1g
ARFA_NGINX_MEM=256m
ARFA_PG_SHARED_BUFFERS=256MB
ARFA_PG_MAX_CONNECTIONS=200

# ---- backups / النسخ الاحتياطي ----
ARFA_BACKUP_KEEP_DAYS=14

# ---- module integration ----
# ir.config_parameter read by wasm_website's "hide from search engines" switch
ARFA_NOINDEX_PARAM=wasm_website.hide_from_search_engines
# modules upgraded by install.sh / update.sh
ARFA_UPDATE_MODULES=wasm_website,wasm_debrand
