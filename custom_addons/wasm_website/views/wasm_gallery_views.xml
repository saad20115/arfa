<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wasm_gallery_tree" model="ir.ui.view">
        <field name="name">wasm.gallery.image.tree</field>
        <field name="model">wasm.gallery.image</field>
        <field name="arch" type="xml">
            <list string="معرض الصور والفيديو">
                <field name="sequence" widget="handle"/>
                <field name="image" widget="image" options="{'size': [64, 48]}"/>
                <field name="media_type"/>
                <field name="name"/>
                <field name="category" optional="show"/>
                <field name="project_id" optional="show"/>
                <field name="service_id" optional="show"/>
                <field name="show_in_gallery" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_wasm_gallery_form" model="ir.ui.view">
        <field name="name">wasm.gallery.image.form</field>
        <field name="model">wasm.gallery.image</field>
        <field name="arch" type="xml">
            <form string="صورة / فيديو">
                <sheet>
                    <widget name="web_ribbon" title="مخفي" bg_color="text-bg-danger" invisible="active"/>
                    <field name="image" widget="image" class="oe_avatar" options="{'size': [180, 130]}"/>
                    <div class="oe_title">
                        <field name="media_type" widget="radio" options="{'horizontal': true}"/>
                        <h2><field name="name" placeholder="تعليق يظهر على الصورة (اختياري)"/></h2>
                    </div>
                    <group string="الفيديو" invisible="media_type != 'video'">
                        <field name="video_file" filename="video_filename" widget="binary"/>
                        <field name="video_filename" invisible="1"/>
                        <field name="video_url" placeholder="https://www.youtube.com/watch?v=... أو رابط MP4" invisible="video_file"/>
                        <div colspan="2" class="text-muted small">الصورة أعلاه تُستخدم كغلاف للفيديو قبل التشغيل (اختياري).</div>
                    </group>
                    <group>
                        <group string="أين تظهر">
                            <field name="project_id"/>
                            <field name="service_id"/>
                            <field name="show_in_gallery" invisible="service_id"/>
                            <field name="category"/>
                        </group>
                        <group string="الترتيب">
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_wasm_gallery_search" model="ir.ui.view">
        <field name="name">wasm.gallery.image.search</field>
        <field name="model">wasm.gallery.image</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <field name="service_id"/>
                <filter name="videos" string="الفيديوهات" domain="[('media_type', '=', 'video')]"/>
                <filter name="photos" string="الصور" domain="[('media_type', '=', 'image')]"/>
                <separator/>
                <filter name="general" string="معرض صفحة المشاريع" domain="[('service_id', '=', False), ('show_in_gallery', '=', True)]"/>
                <filter name="archived" string="المخفية" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_service" string="الخدمة" context="{'group_by': 'service_id'}"/>
                    <filter name="group_project" string="المشروع" context="{'group_by': 'project_id'}"/>
                    <filter name="group_category" string="التصنيف" context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_wasm_gallery_kanban" model="ir.ui.view">
        <field name="name">wasm.gallery.image.kanban</field>
        <field name="model">wasm.gallery.image</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="media_type"/>
                <templates>
                    <t t-name="card">
                        <div class="text-center">
                            <field name="image" widget="image" options="{'size': [180, 130]}" class="rounded-3 mx-auto mb-2"/>
                            <div t-if="record.media_type.raw_value == 'video'" class="badge text-bg-dark mb-1"><i class="fa fa-play me-1" title="Video"/>فيديو</div>
                            <h6 class="fw-bold mb-1"><field name="name"/></h6>
                            <div class="small text-muted"><field name="service_id"/><field name="project_id"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action -->
    <record id="action_wasm_gallery" model="ir.actions.act_window">
        <field name="name">معرض الصور والفيديو</field>
        <field name="res_model">wasm.gallery.image</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                أضف صوراً أو فيديوهات (رفع ملف MP4 أو رابط YouTube) للمشاريع والخدمات ومعرض صفحة المشاريع
            </p>
        </field>
    </record>
</odoo>
