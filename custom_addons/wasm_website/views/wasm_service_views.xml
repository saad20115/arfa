<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_wasm_service_form" model="ir.ui.view">
        <field name="name">wasm.service.form</field>
        <field name="model">wasm.service</field>
        <field name="arch" type="xml">
            <form string="الخدمة">
                <header>
                    <field name="active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_on_website" type="object" class="oe_stat_button" icon="fa-globe" invisible="not slug">
                            <div class="o_stat_info"><span class="o_stat_text">عرض في الموقع</span></div>
                        </button>
                    </div>
                    <field name="image" widget="image" class="oe_avatar" options="{'size': [160, 110]}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="مثال: Medical Gas Systems"/></h1>
                    </div>
                    <group>
                        <group string="الكارت">
                            <field name="icon" placeholder="fa-bolt"/>
                            <field name="show_on_home" widget="boolean_toggle"/>
                            <field name="sequence"/>
                            <field name="category"/>
                        </group>
                        <group string="صفحة الخدمة">
                            <field name="slug" placeholder="medical-gas-systems"/>
                            <field name="website_url" widget="url" readonly="1"/>
                            <field name="banner_image" widget="image" options="{'size': [200, 110]}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="نصوص الكروت" name="cards">
                            <group>
                                <field name="card_description" placeholder="النص تحت اسم الخدمة في سلايدر الصفحة الرئيسية"/>
                                <field name="short_description" placeholder="النص تحت اسم الخدمة في صفحة الخدمات"/>
                            </group>
                        </page>
                        <page string="محتوى صفحة الخدمة" name="page">
                            <group>
                                <field name="page_title" placeholder="يُستخدم اسم الخدمة إذا تُرك فارغاً"/>
                                <field name="badge"/>
                                <field name="intro"/>
                                <field name="features" placeholder="ميزة في كل سطر"/>
                            </group>
                            <label for="detailed_description" string="شرح إضافي (اختياري)"/>
                            <field name="detailed_description"/>
                        </page>
                        <page string="معرض الصور والفيديو" name="media">
                            <field name="media_ids" context="{'default_service_id': id, 'default_show_in_gallery': False}">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="image" widget="image" options="{'size': [90, 60]}"/>
                                    <field name="media_type"/>
                                    <field name="name"/>
                                    <field name="video_url" optional="show"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View for Services (Click row to open Form view) -->
    <record id="view_wasm_service_tree" model="ir.ui.view">
        <field name="name">wasm.service.tree</field>
        <field name="model">wasm.service</field>
        <field name="arch" type="xml">
            <list string="الخدمات الإنشائية">
                <field name="sequence" widget="handle"/>
                <field name="name" decoration-bf="1"/>
                <field name="category"/>
                <field name="icon"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Kanban View for Services -->
    <record id="view_wasm_service_kanban" model="ir.ui.view">
        <field name="name">wasm.service.kanban</field>
        <field name="model">wasm.service</field>
        <field name="arch" type="xml">
            <kanban sample="1">
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-center p-2 gap-3">
                            <field name="image" widget="image" style="width: 70px; height: 70px; object-fit: cover;" class="rounded shadow-sm"/>
                            <div class="flex-grow-1">
                                <div class="fw-bold fs-6 mb-1 text-dark">
                                    <field name="name"/>
                                </div>
                                <div class="text-muted small mb-2">
                                    <field name="category"/>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="badge bg-light text-dark border">
                                        <field name="icon"/>
                                    </span>
                                    <field name="active" widget="boolean_toggle"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View for Services -->
    <record id="view_wasm_service_search" model="ir.ui.view">
        <field name="name">wasm.service.search</field>
        <field name="model">wasm.service</field>
        <field name="arch" type="xml">
            <search string="البحث في الخدمات">
                <field name="name"/>
                <field name="category"/>
                <filter string="أرشيف" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_wasm_service" model="ir.actions.act_window">
        <field name="name">الخدمات الإنشائية - عرفة الهندسية</field>
        <field name="res_model">wasm.service</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_wasm_service_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                إضافة خدمة إنشائية جديدة لشركة عرفة الهندسية
            </p>
            <p>
                يمكنك إضافة وتحديث ونشر الخدمات الإنشائية لتظهر فوراً في واجهة الموقع ومعرض الخدمات.
            </p>
        </field>
    </record>

</odoo>
