<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View for Wasm Site Media & Settings Config -->
    <record id="view_wasm_site_config_form" model="ir.ui.view">
        <field name="name">wasm.site.config.form</field>
        <field name="model">wasm.site.config</field>
        <field name="arch" type="xml">
            <form string="إعدادات ووسائط الموقع الإلكتروني" create="0" delete="0" duplicate="0">
                <header>
                    <button name="action_view_website" type="object" string="معاينة الموقع" class="btn-primary" icon="fa-globe"/>
                </header>
                <sheet>
                    <div class="oe_title mb-4">
                        <h1>
                            <field name="name" placeholder="اسم التكوين"/>
                        </h1>
                        <p class="text-muted">التحكم في وسائط الموقع، إعدادات الأعداد المعروضة، والفيديو والصور من لوحة التحكم Backend</p>
                    </div>

                    <notebook>
                        <!-- Tab 1: Projects & Section Display Controls -->
                        <page string="التحكم في أعداد المشاريع والأقسام (Display Limits &amp; Visibility)" name="limits_settings">
                            <group>
                                <group string="الصفحة الرئيسية (Homepage Limits)">
                                    <field name="home_projects_limit"/>
                                    <field name="show_testimonials" widget="boolean_toggle"/>
                                </group>
                                <group string="صفحة معرض المشاريع (Projects Page)">
                                    <field name="projects_page_limit"/>
                                </group>
                            </group>
                            <div class="alert alert-info shadow-sm rounded-3 mt-3" role="status">
                                <i class="fa fa-info-circle me-2"/>
                                <strong>تنويه:</strong> يتم عرض كروت المشاريع النشطة فقط بالموقع. إذا قمت بإيقاف تنشيط أي مشروع ستجده دائماً آتم وحفوظ في الفلاتر <em>(المشاريع المعطلة / الأرشيف)</em> داخل جدول المشاريع.
                            </div>
                        </page>

                        <!-- Tab 2: Video & Showcase Settings -->
                        <page string="فيديو ومحتوى رؤية عرفة (Corporate Showcase Video)" name="video_settings">
                            <group>
                                <group string="العنوان الرئيسي والشرح">
                                    <field name="showcase_title_ar"/>
                                    <field name="showcase_title_en"/>
                                    <field name="showcase_desc_ar"/>
                                    <field name="showcase_desc_en"/>
                                </group>
                                <group string="الوسائط والفيديو">
                                    <field name="showcase_video_file" filename="showcase_video_filename" widget="binary"/>
                                    <field name="showcase_video_filename" invisible="1"/>
                                    <field name="showcase_video_url"/>
                                    <field name="showcase_poster" widget="image" class="oe_avatar" style="max-width: 250px; max-height: 180px;"/>
                                    <field name="showcase_bg_image" widget="image" class="oe_avatar" style="max-width: 250px; max-height: 180px;"/>
                                </group>
                            </group>
                            <group string="النقاط والمميزات (Bullets)">
                                <group string="النقطة الأولى (SBC Code)">
                                    <field name="showcase_bullet1_ar"/>
                                    <field name="showcase_bullet1_en"/>
                                </group>
                                <group string="النقطة الثانية (MEP Systems)">
                                    <field name="showcase_bullet2_ar"/>
                                    <field name="showcase_bullet2_en"/>
                                </group>
                                <group string="النقطة الثالثة (Accredited Engineers)">
                                    <field name="showcase_bullet3_ar"/>
                                    <field name="showcase_bullet3_en"/>
                                </group>
                            </group>
                        </page>

                        <!-- Tab 3: Hero Banner & Images -->
                        <page string="صور وعناوين الهيرو (Hero Section)" name="hero_settings">
                            <group>
                                <group string="العنوان الفرعي تحت اسم الشركة">
                                    <field name="hero_title_ar"/>
                                    <field name="hero_title_en"/>
                                </group>
                                <group string="فيديو وخلفية الهيرو">
                                    <field name="home_hero_video_file" filename="home_hero_video_filename" widget="binary"/>
                                    <field name="home_hero_video_filename" invisible="1"/>
                                    <field name="home_hero_video_url" invisible="home_hero_video_file"/>
                                    <field name="hero_bg_image" widget="image" class="oe_avatar" style="max-width: 250px; max-height: 250px;"/>
                                </group>
                            </group>
                        </page>

                        <!-- Tab 4: Contact Info -->
                        <page string="معلومات التواصل السريعة" name="contact_settings">
                            <group>
                                <group string="بيانات التواصل والهاتف">
                                    <field name="contact_phone"/>
                                    <field name="contact_phone_secondary"/>
                                    <field name="contact_email"/>
                                </group>
                                <group string="العنوان وأوقات العمل">
                                    <field name="contact_address_ar"/>
                                    <field name="contact_address_en"/>
                                    <field name="contact_working_hours_ar"/>
                                    <field name="contact_working_hours_en"/>
                                </group>
                            </group>
                        </page>

                        <!-- Tab: page images, maps -->
                        <page string="صور الصفحات والخرائط" name="pages_media">
                            <group>
                                <group string="صور الصفحات">
                                    <field name="about_image" widget="image" class="oe_avatar" style="max-width: 250px; max-height: 180px;"/>
                                    <field name="footer_logo" widget="image" class="oe_avatar" style="max-width: 200px; max-height: 120px;"/>
                                </group>
                                <group string="الخرائط (رابط التضمين من Google Maps)">
                                    <field name="map_embed_url" placeholder="https://www.google.com/maps/embed?pb=..."/>
                                    <field name="map_link_url" widget="url"/>
                                    <field name="hq_map_embed_url" placeholder="https://www.google.com/maps/embed?pb=..."/>
                                    <field name="hq_map_link_url" widget="url"/>
                                </group>
                            </group>
                            <div class="alert alert-info shadow-sm rounded-3 mt-3" role="status">
                                <i class="fa fa-map-marker me-2" title="Map"/>
                                للحصول على رابط الخريطة: افتح الموقع في Google Maps ← مشاركة ← تضمين خريطة ← انسخ الرابط الموجود داخل src="...".
                                إذا تركت أي صورة فارغة يظهر التصميم الافتراضي.
                            </div>
                        </page>

                        <!-- Tab: where to edit the rest of the content -->
                        <page string="باقي محتوى الموقع" name="content_shortcuts">
                            <div class="row g-3 mt-1">
                                <div class="col-md-6 col-lg-4">
                                    <button name="%(wasm_website.action_wasm_text)d" type="action" class="btn btn-outline-primary w-100 text-start p-3" icon="fa-font">
                                        <strong> نصوص الموقع</strong><br/><small class="text-muted">كل العناوين والفقرات والأزرار والنماذج والفوتر</small>
                                    </button>
                                </div>
                                <div class="col-md-6 col-lg-4">
                                    <button name="%(wasm_website.action_wasm_content_item)d" type="action" class="btn btn-outline-primary w-100 text-start p-3" icon="fa-th-large">
                                        <strong> الكروت والقوائم</strong><br/><small class="text-muted">كروت الواجهة، الإحصائيات، لماذا عرفة، الفريق، الخبرات، الأقسام، روابط الفوتر، المساعد الذكي</small>
                                    </button>
                                </div>
                                <div class="col-md-6 col-lg-4">
                                    <button name="%(wasm_website.action_wasm_service)d" type="action" class="btn btn-outline-primary w-100 text-start p-3" icon="fa-cogs">
                                        <strong> الخدمات</strong><br/><small class="text-muted">كروت الخدمات وصفحة كل خدمة ومعرض صورها وفيديوهاتها</small>
                                    </button>
                                </div>
                                <div class="col-md-6 col-lg-4">
                                    <button name="%(wasm_website.action_wasm_project)d" type="action" class="btn btn-outline-primary w-100 text-start p-3" icon="fa-building">
                                        <strong> المشاريع</strong><br/><small class="text-muted">المشاريع وتفاصيلها وصورها</small>
                                    </button>
                                </div>
                                <div class="col-md-6 col-lg-4">
                                    <button name="%(wasm_website.action_wasm_gallery)d" type="action" class="btn btn-outline-primary w-100 text-start p-3" icon="fa-picture-o">
                                        <strong> معرض الصور والفيديو</strong><br/><small class="text-muted">صور وفيديوهات صفحة المشاريع والخدمات</small>
                                    </button>
                                </div>
                                <div class="col-md-6 col-lg-4">
                                    <button name="%(wasm_website.action_wasm_news)d" type="action" class="btn btn-outline-primary w-100 text-start p-3" icon="fa-newspaper-o">
                                        <strong> الأخبار</strong><br/><small class="text-muted">الأخبار والمقالات</small>
                                    </button>
                                </div>
                            </div>
                        </page>

                        <!-- Tab 9: Company Profile PDF -->
                        <page string="ملف البروفايل الخاص بالشركة (PDF)" name="company_profile_settings">
                            <group>
                                <group string="تحميل بروفايل الشركة">
                                    <field name="company_profile_pdf" filename="company_profile_filename" widget="binary"/>
                                    <field name="company_profile_filename"/>
                                </group>
                            </group>
                            <div class="alert alert-info shadow-sm rounded-3 mt-3" role="status">
                                <i class="fa fa-info-circle me-2"/>
                                <strong>تنويه:</strong> عند رفع ملف PDF جديد هنا، سيتم تقديمه للزوار فوراً عند النقر على زر "تحميل بروفايل الشركة" في الهيرو وجميع أقسام الموقع.
                            </div>
                        </page>

                        <!-- Tab: Brand, SEO & AI search -->
                        <page string="محركات البحث والذكاء الاصطناعي (SEO)" name="seo_settings">
                            <group>
                                <group string="هوية الشركة">
                                    <field name="brand_name_ar"/>
                                    <field name="brand_name_en"/>
                                    <field name="founding_year"/>
                                    <field name="service_area" placeholder="مثال: الرياض، جدة، مكة، المنطقة الشرقية"/>
                                    <field name="hide_from_search_engines" widget="boolean_toggle"/>
                                </group>
                                <group string="وصف الموقع في جوجل ومساعدات الذكاء الاصطناعي">
                                    <field name="seo_description_ar"/>
                                    <field name="seo_description_en"/>
                                </group>
                            </group>
                            <div class="alert alert-info shadow-sm rounded-3 mt-3" role="status">
                                <i class="fa fa-search me-2" title="SEO"/>
                                <strong>كيف تُستخدم هذه البيانات:</strong> يظهر الوصف في نتائج جوجل لأي صفحة ليس لها وصف خاص،
                                وتُبنى منه ومن بيانات التواصل والخدمات بطاقة الشركة لمحركات البحث (Schema.org)
                                وملف <code>/llms.txt</code> الذي تقرؤه مساعدات الذكاء الاصطناعي (ChatGPT، Claude، Perplexity، Gemini).
                                يمكن أيضاً تخصيص عنوان ووصف كل صفحة من محرر الموقع ← تحسين SEO.
                            </div>
                        </page>

                        <!-- Tab: Social media -->
                        <page string="حسابات التواصل الاجتماعي" name="social_settings">
                            <group>
                                <group string="الروابط (تظهر في الفوتر وتُرسل لمحركات البحث)">
                                    <field name="social_linkedin" widget="url" placeholder="https://www.linkedin.com/company/..."/>
                                    <field name="social_x" widget="url" placeholder="https://x.com/..."/>
                                    <field name="social_instagram" widget="url" placeholder="https://www.instagram.com/..."/>
                                    <field name="social_facebook" widget="url" placeholder="https://www.facebook.com/..."/>
                                </group>
                                <group string=" ">
                                    <field name="social_youtube" widget="url" placeholder="https://www.youtube.com/@..."/>
                                    <field name="social_tiktok" widget="url" placeholder="https://www.tiktok.com/@..."/>
                                    <field name="social_snapchat" widget="url" placeholder="https://www.snapchat.com/add/..."/>
                                </group>
                            </group>
                            <div class="alert alert-info shadow-sm rounded-3 mt-3" role="status">
                                <i class="fa fa-share-alt me-2" title="Social"/>
                                أي حساب تتركه فارغاً تختفي أيقونته من الفوتر تلقائياً. رابط واتساب يُؤخذ من رقم الجوال في تبويب معلومات التواصل.
                            </div>
                        </page>

                        <!-- Tab 10: Mail Server & Email Alerts -->
                        <page string="📧 ربط الميل سيرفر وإشعارات النماذج (Email Alerts &amp; Server Integration)" name="email_server_settings">
                            <group>
                                <group string="إعدادات البريد المستهدف">
                                    <field name="target_notification_email" placeholder="e.g. info@arfa-sa.com"/>
                                </group>
                                <group string="تحكم الإشعارات البريدية التلقائية">
                                    <field name="enable_email_notifications" widget="boolean_toggle"/>
                                    <field name="enable_customer_confirmation_email" widget="boolean_toggle"/>
                                </group>
                            </group>
                            <div class="alert alert-warning shadow-sm rounded-3 mt-3" role="status">
                                <i class="fa fa-envelope me-2"/>
                                <strong>ربط خادم البريد (Mail Server):</strong> يتم إرسال الإشعارات والرسائل التلقائية عبر خادم البريد الصادر المعرّف في أودو <em>(الإعدادات -&gt; خوادم البريد الصادر / Outgoing Mail Servers)</em>. يتضمن كل إشعار بريدي <strong>الرقم المرجعي المميز</strong> ورابط مباشر لمتابعة الطلب في لوحة التحكم.
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action for Site Config (Window Action) -->
    <record id="action_wasm_site_config" model="ir.actions.act_window">
        <field name="name">وسائط وتكوين الموقع</field>
        <field name="res_model">wasm.site.config</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <!-- Singleton Server Action for Site Config -->
    <record id="action_wasm_site_config_singleton" model="ir.actions.server">
        <field name="name">وسائط وتكوين الموقع</field>
        <field name="model_id" ref="model_wasm_site_config"/>
        <field name="state">code</field>
        <field name="code">
action = env['wasm.site.config'].action_open_config()
        </field>
    </record>

</odoo>
