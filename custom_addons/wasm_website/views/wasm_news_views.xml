<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree / List View -->
    <record id="view_wasm_news_tree" model="ir.ui.view">
        <field name="name">wasm.news.tree</field>
        <field name="model">wasm.news</field>
        <field name="arch" type="xml">
            <list string="الأخبار والمقالات">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category"/>
                <field name="date"/>
                <field name="author"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_wasm_news_form" model="ir.ui.view">
        <field name="name">wasm.news.form</field>
        <field name="model">wasm.news</field>
        <field name="arch" type="xml">
            <form string="تفاصيل الخبر / المقال">
                <sheet>
                    <field name="image" widget="image" class="oe_avatar" options="{'size': [120, 120]}"/>
                    <div class="oe_title">
                        <label for="name" string="عنوان المقال / الخبر"/>
                        <h1>
                            <field name="name" placeholder="أدخل عنوان الخبر..." required="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="category"/>
                            <field name="date"/>
                            <field name="author"/>
                        </group>
                        <group>
                            <field name="slug" placeholder="عنوان مسار الخبر URL"/>
                            <field name="image_url" placeholder="https://... (اختياري إذا لم ترفع صورة)"/>
                            <field name="badge_en" placeholder="e.g. Project Milestone (optional)"/>
                            <field name="badge_ar" placeholder="مثال: إنجازات المشاريع (اختياري)"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="الملخص العربي" name="summary_page">
                            <field name="summary" placeholder="موجز الخبر المعروض في كارت قائمة الأخبار..."/>
                        </page>
                        <page string="النسخة الإنجليزية (English)" name="english_page">
                            <group>
                                <field name="title_en" placeholder="Article title in English"/>
                                <field name="summary_en" placeholder="Short English summary for the news card"/>
                            </group>
                            <field name="content_en" widget="html" placeholder="Full English article..."/>
                        </page>
                        <page string="محتوى المقال الكامل (HTML)" name="content_page">
                            <field name="content" widget="html" placeholder="اكتب محتوى المقال الهندسي الكامل هنا..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_wasm_news_kanban" model="ir.ui.view">
        <field name="name">wasm.news.kanban</field>
        <field name="model">wasm.news</field>
        <field name="arch" type="xml">
            <kanban default_group_by="category">
                <field name="id"/>
                <field name="name"/>
                <field name="category"/>
                <field name="date"/>
                <field name="image"/>
                <templates>
                    <t t-name="card">
                        <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden p-2">
                            <div class="d-flex align-items-center gap-3">
                                <field name="image" widget="image" options="{'size': [75, 75]}" class="rounded-3"/>
                                <div>
                                    <h6 class="fw-bold mb-1"><field name="name"/></h6>
                                    <div class="small text-muted"><field name="date"/></div>
                                    <span class="badge bg-warning text-dark me-1"><field name="category"/></span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action -->
    <record id="action_wasm_news" model="ir.actions.act_window">
        <field name="name">الأخبار والمقالات</field>
        <field name="res_model">wasm.news</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                إضافة خبر أو مقال جديد لموقع الشركة
            </p>
        </field>
    </record>
</odoo>
