<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_wasm" model="ir.module.category">
            <field name="name">عرفة الهندسية</field>
            <field name="sequence">100</field>
        </record>

        <record id="privilege_wasm_access" model="res.groups.privilege">
            <field name="name">صلاحيات عرفة الهندسية</field>
            <field name="category_id" ref="module_category_wasm"/>
            <field name="sequence">10</field>
            <field name="placeholder">بدون صلاحية</field>
        </record>

        <record id="group_wasm_user" model="res.groups">
            <field name="name">مستخدم طلبات عرفة الهندسية</field>
            <field name="privilege_id" ref="privilege_wasm_access"/>
            <!-- explicit: exactly these implied groups (the upgrade resets manual changes) -->
            <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        </record>

        <record id="group_wasm_manager" model="res.groups">
            <field name="name">مدير عام عرفة الهندسية</field>
            <field name="privilege_id" ref="privilege_wasm_access"/>
            <!-- implies the user group only (never Settings / Administration) -->
            <field name="implied_ids" eval="[(6, 0, [ref('group_wasm_user')])]"/>
        </record>
    </data>
</odoo>
